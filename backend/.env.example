# Appointment Voice Chatbot Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# Twilio Configuration (Required for voice functionality)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WEBHOOK_URL=https://your-domain.ngrok-free.dev

# AI Provider API Keys (At least one required)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SARVAM_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LiveKit Configuration (Required for LiveKit voice pipeline)
LIVEKIT_URL=wss://your-livekit-url.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Server Settings
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept
CORS_ALLOW_CREDENTIALS=true

# Database Configuration
DATABASE_URL=sqlite:///./appointments.db

# AI Model Configuration
LLM_PROVIDER=openai
MODEL_NAME=
OPENAI_MODEL=gpt-4o
GROQ_MODEL=llama-3.3-70b-versatile
AI_TEMPERATURE=0.7

# Business Configuration
TIMEZONE=Asia/Kolkata
BUSINESS_START_HOUR=9
BUSINESS_END_HOUR=17

# Logging Configuration
# Available log levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_LEVEL_CONSOLE=INFO

# Tracing (LangChain)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=Voice-calling-agent

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================

# 1. Twilio Setup:
#    - Sign up at https://www.twilio.com/
#    - Get your Account SID and Auth Token from the Twilio Console
#    - Purchase a phone number with voice capabilities
#    - Configure webhooks in your phone number settings

# 2. OpenAI Setup:
#    - Sign up at https://platform.openai.com/
#    - Create an API key in your account settings

# 3. Groq Setup (Optional):
#    - Sign up at https://console.groq.com/
#    - Create an API key in your account settings

# 4. Sarvam AI Setup:
#    - Sign up at https://www.sarvam.ai/
#    - Get your API key from the dashboard

# 5. LiveKit Setup:
#    - Create a project at https://livekit.io/
#    - Get your URL, API Key, and Secret

# 6. Local development with Twilio:
#    - Install ngrok: https://ngrok.com/
#    - Run: ngrok http 8000
#    - Use the https URL for TWILIO_WEBHOOK_URL